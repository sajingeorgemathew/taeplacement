# Copy this file to .env.local and fill in the values from the Supabase project.
# .env.local is ignored by Git. Never commit real keys.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by scripts/import-initial-students.ts for the one-time workbook
# migration, and by the Resend delivery webhook at /api/resend/webhook, which
# has no signed in staff member behind it and still has to advance a delivery
# status. Those are the only two callers. This key bypasses Row Level Security,
# so it must never be added to a NEXT_PUBLIC_ variable and must never be sent to
# the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend - outbound placement document email (PLACEMENT-06A)
#
# Server only. NONE of these may ever become a NEXT_PUBLIC_ variable and none
# of them may be read from client code. Leave them blank to run the application
# with email sending switched off: pages, the build, and every other module work
# without them, and only a send is refused, with a plain message.
# ---------------------------------------------------------------------------

# The Resend API key. Live keys send real email. Never commit a real value.
RESEND_API_KEY=

# The verified sending address.
# Production: Toronto Academy Placement <placement@mail.portal-torontoacademy.ca>
RESEND_FROM_EMAIL=

# Where student replies are read. Deliberately NOT the sending address:
# receiving through Resend is off, so replies go to the real mailbox.
# Production: placement@torontoacademy.ca
RESEND_REPLY_TO=

# The signing secret for the delivery webhook at /api/resend/webhook.
# Only needed once the webhook endpoint is registered in Resend. Until then the
# route refuses every request rather than trusting an unsigned one.
RESEND_WEBHOOK_SECRET=
