# Copy this file to .env.local and fill in the values from the Supabase project.
# .env.local is ignored by Git. Never commit real keys.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local only. Used by scripts/import-initial-students.ts for the one-time
# workbook migration. This key bypasses Row Level Security, so it must never be
# added to a NEXT_PUBLIC_ variable and must never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
